{
  "name": "dealett-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "npm run test:platform && npm run test:migrations && npm run test:legacy",
    "test:platform": "node --test platform.test.js",
    "test:migrations": "node --test migration.test.js",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:down": "node scripts/migrate.js down",
    "db:seed": "node scripts/seed-demo.js",
    "db:reset-demo": "node scripts/seed-demo.js --reset",
    "db:import-legacy": "node scripts/import-legacy-json.js --dry-run",
    "check": "node scripts/check.js",
    "test:legacy": "npm run test:translation && npm run test:recommendations && npm run test:cost-calculator && npm run test:best-match && npm run test:chat-dynamic && npm run test:quiz-consent && npm run test:customer-service && npm run test:conversation-state && npm run test:binding-time && npm run test:adaptive-questions && npm run test:recommendation-parity && npm run test:chat-ui-response && npm run test:chat-feedback",
    "test:translation": "node translation-service.test.js",
    "test:recommendations": "node offer-calculator.test.js",
    "test:cost-calculator": "node cost-calculator.test.js",
    "test:best-match": "node best-match.test.js",
    "test:chat-dynamic": "node chat-service.dynamic.test.js",
    "test:quiz-consent": "node quiz-consent.test.js",
    "test:customer-service": "node src/customerServiceBehavior.test.js",
    "test:conversation-state": "node src/conversationState.test.js",
    "test:binding-time": "node src/bindingTime.test.js",
    "test:adaptive-questions": "node src/adaptiveQuestionPolicy.test.js",
    "test:recommendation-parity": "node recommendation-parity.test.js",
    "test:chat-ui-response": "node src/chatUiResponse.test.js",
    "test:chat-feedback": "node src/chatFeedback.test.js",
    "test:all": "npm run check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
