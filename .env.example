NODE_ENV=development
PORT=3000

# Demo mode is the only mode allowed to use the in-memory repository and mock identities.
DEMO_MODE=true
DEALETT_REPOSITORY=memory

# PostgreSQL is mandatory whenever DEMO_MODE=false.
DATABASE_URL=postgresql://dealett:dealett@127.0.0.1:5432/dealett
DATABASE_SSL=false
# Required only for destructive db:reset-demo; the database name must also contain "demo" or "test".
RESET_DEMO_CONFIRM=
# 32 random bytes encoded as base64; required outside demo mode for encrypted PII fields.
DEALETT_DATA_ENCRYPTION_KEY=

# Comma-separated browser origins. Wildcards are rejected.
CORS_ORIGINS=https://lollekacc.github.io,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://[::1]:5500

# Public endpoint limits per rolling minute.
PUBLIC_CHAT_RATE_LIMIT=30
PUBLIC_ORDER_RATE_LIMIT=10

# AI remains unavailable rather than silently scripted outside explicit demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna

# Existing compatibility storage; used only by legacy routes/import tooling.
DEALETT_DATA_DIR=./data
